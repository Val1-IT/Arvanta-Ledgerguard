# ---------------------------------------------------------------------------
# Arvanta LedgerGuard — environment template
# Copy to .env (git-ignored) and fill in. NEVER commit real secrets.
# Variable names and comments only — no real values are stored here.
# ---------------------------------------------------------------------------

# =============================================================================
# REQUIRED — the app will not run correctly without these.
# =============================================================================

# Demo runtime guard. Simulation and destructive/reset endpoints are only
# enabled when this is exactly "true". Keep disabled in any shared/public env
# where you do not want judges triggering data mutations without protection.
DEMO_MODE=true

# Runtime truthfulness policy. These values are checked only when exactly
# "true". Judge mode always disables the static DataHub fallback.
# Local development: false / true / false.
# Judging: true / false / true (plus a real ANTHROPIC_API_KEY and DataHub).
JUDGE_MODE=false
ALLOW_DEMO_FALLBACK=true
REQUIRE_LIVE_MODEL=false

# --- Demo PostgreSQL (separate from any Arvanta database) -------------------
# Matches docker-compose.yml defaults. This is a throwaway demo database with
# synthetic data only. Do NOT point this at Arvanta or any production DB.
DATABASE_URL=postgres://ledgerguard:ledgerguard@localhost:5433/ledgerguard

# =============================================================================
# OPTIONAL — DataHub context (metadata, lineage, MCP read/write-back).
# The app still runs without these, but the agent's DataHub-grounded
# investigation and write-back steps will be skipped or reported as failed.
# =============================================================================

# For DataHub OSS quickstart the GMS URL is typically http://localhost:8080.
DATAHUB_GMS_URL=http://localhost:8080
# Personal access token from DataHub (Settings > Access Tokens). Leave blank
# for token-less local OSS instances that do not enforce auth.
DATAHUB_GMS_TOKEN=

# DataHub MCP server endpoint/command, used by the investigation agent to
# read metadata and write back resolution status.
DATAHUB_MCP_URL=
DATAHUB_MCP_TOKEN=

# =============================================================================
# OPTIONAL — model provider (investigation narration only).
# LLM_PROVIDER accepts: anthropic | openai | deterministic
# Without a live key the agent uses the deterministic template narrator unless
# REQUIRE_LIVE_MODEL=true. Every number and every data mutation is still
# computed by non-LLM code.
#
# Local development (no API key needed):
#   LLM_PROVIDER=deterministic
#   REQUIRE_LIVE_MODEL=false
#
# Judging with OpenAI:
#   JUDGE_MODE=true
#   ALLOW_DEMO_FALLBACK=false
#   REQUIRE_LIVE_MODEL=true
#   LLM_PROVIDER=openai
#   OPENAI_API_KEY=...
#
# Judging with Anthropic:
#   JUDGE_MODE=true
#   ALLOW_DEMO_FALLBACK=false
#   REQUIRE_LIVE_MODEL=true
#   LLM_PROVIDER=anthropic
#   ANTHROPIC_API_KEY=...
# =============================================================================

LLM_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Backward-compatible model override used only when the provider-specific
# OPENAI_MODEL / ANTHROPIC_MODEL value is blank.
LLM_MODEL=
