{
  "name": "ledgerguard",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source safety runtime for AI agents operating on systems of record. LLMs may investigate and propose repairs; LedgerGuard decides whether mutations may execute.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Val1-IT/Arvanta-Ledgerguard.git"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "demo": "pnpm install --frozen-lockfile --prod=false && pnpm run scenario:duplicate-inventory:memory",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit && pnpm --filter @ledgerguard/core typecheck && pnpm --filter @ledgerguard/postgres typecheck && pnpm --filter @ledgerguard/datahub typecheck && pnpm --filter @ledgerguard/policy typecheck",
    "lint": "next lint",
    "test": "vitest run && pnpm --filter @ledgerguard/core test && pnpm --filter @ledgerguard/postgres test && pnpm --filter @ledgerguard/datahub test && pnpm --filter @ledgerguard/policy test",
    "test:core": "pnpm --filter @ledgerguard/core test",
    "test:postgres": "pnpm --filter @ledgerguard/postgres test",
    "test:datahub-pkg": "pnpm --filter @ledgerguard/datahub test",
    "test:watch": "vitest",
    "test:ui": "vitest run tests/unit/ui",
    "test:e2e": "playwright test",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "verify:integration": "pnpm run db:migrate && pnpm run test:integration",
    "release:check": "pnpm run verify",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:nuke": "docker compose down -v",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "tsx src/db/reset.ts",
    "db:setup": "pnpm run db:up && pnpm run db:wait && pnpm run db:migrate && pnpm run db:seed",
    "db:wait": "tsx src/db/wait.ts",
    "scenario:conversion-error": "tsx demo-data/scenarios/conversion-error.ts",
    "scenario:duplicate-inventory": "tsx demo-data/scenarios/duplicate-inventory.ts",
    "scenario:duplicate-inventory:memory": "tsx examples/inventory-ledger/src/run.ts",
    "example": "tsx scripts/generate-example.ts",
    "example:agent": "tsx scripts/generate-agent-example.ts",
    "datahub:up": "node scripts/py.mjs -m datahub docker quickstart",
    "datahub:down": "node scripts/py.mjs -m datahub docker quickstart --stop",
    "datahub:status": "node scripts/py.mjs -m datahub docker check",
    "datahub:bootstrap": "node scripts/py.mjs -m src.datahub.bootstrap",
    "datahub:mcp-proof": "node scripts/py.mjs -m src.datahub.mcp.proof",
    "datahub:writeback-proof": "node scripts/py.mjs -m src.datahub.mcp.writeback",
    "datahub:metadata-reset": "node scripts/py.mjs -m src.datahub.mcp.writeback --restore",
    "datahub:mcp-mutation-proof": "node scripts/py.mjs -m src.datahub.mcp.mutation_proof",
    "judge:preflight": "tsx scripts/judge-preflight.ts",
    "proof:judge-flow": "tsx scripts/proof-judge-flow.ts",
    "test:datahub": "vitest run --config vitest.datahub.config.ts",
    "test:agent": "vitest run tests/unit/agent && vitest run --config vitest.datahub.config.ts tests/datahub/agent-orchestrator.test.ts tests/datahub/live-model-smoke.test.ts"
  },
  "dependencies": {
    "@ledgerguard/core": "workspace:*",
    "@ledgerguard/postgres": "workspace:*",
    "@ledgerguard/datahub": "workspace:*",
    "@ledgerguard/policy": "workspace:*",
    "@anthropic-ai/sdk": "^0.114.0",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.36.4",
    "lucide-react": "^0.542.0",
    "next": "^15.5.18",
    "openai": "^7.3.0",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.54.2",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.28.1",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.15",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
