{
  "name": "arvanta-ledgerguard",
  "version": "0.1.0",
  "private": true,
  "description": "Autonomous ERP financial-integrity agent powered by DataHub context. Detects, traces, explains, and safely remediates the financial-statement impact of operational data errors.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:nuke": "docker compose down -v",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "tsx src/db/reset.ts",
    "db:setup": "npm run db:up && npm run db:wait && npm run db:migrate && npm run db:seed",
    "db:wait": "tsx src/db/wait.ts",
    "scenario:conversion-error": "tsx demo-data/scenarios/conversion-error.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.36.4",
    "lucide-react": "^0.542.0",
    "next": "^15.5.18",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.28.1",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.15",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
